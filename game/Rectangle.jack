// Circle.jack - Represents the Circle object

class Rectangle {
    field int x, y; 
    field int width, height;

    constructor Rectangle new(int ax, int ay, int awidth, int aheight) {
        let x = ax;
        let y = ay;
        let width = awidth;
        let height = aheight;
        do draw();
        return this;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    method void draw() {
        do Screen.setColor(true);
        do Screen.drawRectangle(x, y, x + width, y + height);
        return;
    }

    method void erase() {
        do Screen.setColor(false);
        do Screen.drawRectangle(x, y, x + width, y + height);
        return;
    }

    method void moveUp() {
        if (x > 0) {
            do erase();
            
            let x = x - 2;
            do draw();
        }
        return;
    }

    method void moveDown() {
        if ((x + width) < 511) {
            do erase();
            let x = x + 2;
            do draw();
        }
        return;
    }

    method void moveLeft() {
        if (y > 0) {
            do erase();
            let y = y - 2;
            do draw();
        }
        return;
    }

    method void moveRight() {
        
        if ((y + height) < 255) {
            do erase();
            let y = y + 2;
            do draw();
        }
        return;
    }

    method void grow() {
        do erase();
        let width = width + 2;
        let height = height + 2;
        if ((x + width) > 511) { let width = 511 - x; }
        if ((y + height) > 255) { let height = 255 - y; }
        do draw();
        return;
    }

    method void shrink() {
        if (width > 4) {
            do erase();
            let width = width - 2;
            do draw();
        }
        if (height > 4) {
            do erase();
            let height = height - 2;
            do draw();
        }
        return;
    }

    method int handleActions() {
        var char key;
        var int moveCounter;
        var boolean exit;

        let moveCounter = 0;
        let exit = false;

        while (~exit) {
            // waits for a key to be pressed
            while (key = 0) {
                let key = Keyboard.keyPressed();
            }

            if (key = 130) { do moveUp(); let moveCounter = moveCounter + 1; }     // up arrow
            if (key = 132) { do moveDown(); let moveCounter = moveCounter + 1; }   // down arrow
            if (key = 131) { do moveLeft(); let moveCounter = moveCounter + 1; }   // left arrow
            if (key = 133) { do moveRight(); let moveCounter = moveCounter + 1; }  // right arrow
            if (key = 66)  { do grow(); let moveCounter = moveCounter + 1; }       // 'b' key
            if (key = 83)  { do shrink(); let moveCounter = moveCounter + 1; }     // 's' key
            if (key = 81)  { let exit = true; } // 'q' key

            // waits for the key to be released
            while (~(key = 0)) {
                let key = Keyboard.keyPressed();
            }
        }
        return moveCounter;
    }
}
